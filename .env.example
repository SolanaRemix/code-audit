# GitHub App Configuration
# Get these values from https://github.com/settings/apps

# Your GitHub App ID
APP_ID=

# Your GitHub App private key (path to .pem file or the key itself as a string)
PRIVATE_KEY=

# Webhook secret for validating incoming webhooks
WEBHOOK_SECRET=

# Optional: Webhook proxy URL for local development (e.g., Smee.io channel)
WEBHOOK_PROXY_URL=

# Optional: GitHub Enterprise Server URL (leave empty for github.com)
GHE_HOST=

# Optional: Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Optional: Port for the app to listen on
PORT=3000

# Optional: Vercel deployment token for automated deployments
VERCEL_TOKEN=

# Optional: Custom configuration
NODE_ENV=production
